{
  "expo": {
    "name": "SpeakFlow Escolas",
    "slug": "v0-project",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "package": "br.com.speakflow.escolas",
      "versionCode": 3,
      "kotlinVersion": "1.9.25",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ],
      "allowBackup": false
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.speakflow.escolas",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "O SpeakFlow Escolas usa o microfone para você gravar suas respostas nas atividades de fala.",
        "NSCameraUsageDescription": "O SpeakFlow Escolas usa a câmera para ler o QR code do seu cartão de acesso."
      }
    },
    "extra": {
      "eas": {
        "projectId": "91793822-7ad9-4eab-9f9e-8b2abf62f57b"
      }
    },
    "owner": "codevelopsolutions",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.25",
            "targetSdkVersion": 36,
            "compileSdkVersion": 36
          }
        }
      ]
    ]
  }
}
